  {
    "id": "general-external-schedule-lookup",
    "description": "외부 멤버의 busy-time 조회는 search_previous_conversations를 먼저, extract_schedules_from_history를 그다음 호출해야 한다.",
    "week": 5,
    "turns": [
      {
        "message": "철수와 영희의 2026년 7월 7일부터 17일까지 바쁜 일정을 알려줘.",
        "expect_tool_called": ["search_previous_conversations", "extract_schedules_from_history"],
        "expect_tool_calls_exact": [
          "search_previous_conversations",
          "extract_schedules_from_history"
        ],
        "expect_tool_call_arguments": [
          {
            "tool_name": "search_previous_conversations",
            "arguments": {"member_names": ["철수", "영희"]}
          },
          {
            "tool_name": "extract_schedules_from_history",
            "arguments": {
              "member_names": ["철수", "영희"],
              "date_from": "2026-07-07",
              "date_to": "2026-07-17"
            }
          }
        ],
        "expect_tool_result_row_keys": [
          {
            "tool_name": "extract_schedules_from_history",
            "keys": [
              "member_name",
              "title",
              "date",
              "start_time",
              "end_time",
              "notes",
              "source_conversation_id"
            ]
          }
        ],
        "expect_tool_result_members": [
          {
            "tool_name": "extract_schedules_from_history",
            "members": ["철수", "영희"]
          }
        ],
        "expect_answer_contains_all": ["철수", "영희"]
      }
    ]
  },
